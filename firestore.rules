rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Daten der App: nur die angemeldete Person selbst
    match /users/{uid}/data/{key} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Erinnerungs-Einstellungen und Geräte für Push: nur die angemeldete Person selbst
    // (der Versand-Job nutzt ein Dienstkonto und ist von diesen Regeln nicht betroffen)
    match /reminders/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
